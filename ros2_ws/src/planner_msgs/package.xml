<?xml version="1.0"?>
<package format="3">
  <name>planner_msgs</name>
  <version>0.1.0</version>
  <description>ROS 2 service mirrors for the GBPlanner operator bridge.</description>
  <maintainer email="angelos.zacharia@ntnu.no">Angelos Zacharia</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <export>
    <build_type>ament_cmake</build_type>
    <ros1_bridge mapping_rules="mapping_rules.yaml"/>
  </export>
</package>
