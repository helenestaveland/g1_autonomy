<?xml version="1.0"?>
<package format="3">
  <name>gbplanner_control_panel</name>
  <version>0.1.0</version>
  <description>RViz2 controls for the GBPlanner services bridged by OmniPlanner.</description>
  <maintainer email="angelos.zacharia@ntnu.no">Angelos Zacharia</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>pluginlib</depend>
  <depend>planner_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rviz_common</depend>
  <depend>std_srvs</depend>
  <depend>qtbase5-dev</depend>
  <export>
    <build_type>ament_cmake</build_type>
    <rviz_common plugin="${prefix}/plugin_description.xml"/>
  </export>
</package>
